@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<EditForm EditContext="_editContext" OnInvalidSubmit="HandleInvalidSubmit">
    <ValidationSummary />
    <button id="concurrent-submit" type="submit">Submit</button>
</EditForm>

@if (_fastValidatorStarted)
{
    <span id="fast-validator-started">fast-started</span>
}

@if (_slowValidatorStarted)
{
    <span id="slow-validator-started">slow-started</span>
}

@if (_editContext.IsValidationPending())
{
    <span id="concurrent-form-pending">pending</span>
}

<button id="release-fast-validator" type="button" @onclick="@(() => _fastValidatorGate.TrySetResult())">Release fast validator</button>
<button id="release-slow-validator" type="button" @onclick="@(() => _slowValidatorGate.TrySetResult())">Release slow validator</button>

@if (_lastCallback is not null)
{
    <span id="concurrent-last-callback">@_lastCallback</span>
}

@code {
    private readonly ConcurrentModel _model = new();
    private readonly TaskCompletionSource _fastValidatorGate = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private readonly TaskCompletionSource _slowValidatorGate = new(TaskCreationOptions.RunContinuationsAsynchronously);
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private bool _fastValidatorStarted;
    private bool _slowValidatorStarted;
    private string _lastCallback;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += HandleValidationRequested;
        _editContext.OnValidationStateChanged += HandleValidationStateChanged;
    }

    private void HandleValidationRequested(object sender, ValidationRequestedEventArgs eventArgs)
    {
        eventArgs.AddAsyncValidator(ValidateFastAsync);
        eventArgs.AddAsyncValidator(ValidateSlowAsync);
    }

    private async Task ValidateFastAsync(CancellationToken cancellationToken)
    {
        _fastValidatorStarted = true;
        await InvokeAsync(StateHasChanged);
        await _fastValidatorGate.Task.WaitAsync(cancellationToken);
        _messages.Add(() => _model.Value, "Fast validator completed");
        _editContext.NotifyValidationStateChanged();
    }

    private async Task ValidateSlowAsync(CancellationToken cancellationToken)
    {
        _slowValidatorStarted = true;
        await InvokeAsync(StateHasChanged);
        await _slowValidatorGate.Task.WaitAsync(cancellationToken);
        _messages.Add(() => _model.Value, "Slow validator completed");
        _editContext.NotifyValidationStateChanged();
    }

    private void HandleValidationStateChanged(object sender, ValidationStateChangedEventArgs eventArgs)
        => InvokeAsync(StateHasChanged);

    private void HandleInvalidSubmit() => _lastCallback = "OnInvalidSubmit";

    public void Dispose()
    {
        _editContext.OnValidationRequested -= HandleValidationRequested;
        _editContext.OnValidationStateChanged -= HandleValidationStateChanged;
    }

    private sealed class ConcurrentModel
    {
        public string Value { get; set; } = string.Empty;
    }
}