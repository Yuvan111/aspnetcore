@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<button id="start-cancelable-validation" type="button" @onclick="StartValidationAsync">Start validation</button>
<button id="cancel-cancelable-validation" type="button" @onclick="CancelValidation">Cancel validation</button>

@if (_validatorStarted)
{
    <span id="cancelable-validator-started">started</span>
}

@if (_editContext.IsValidationPending())
{
    <span id="cancelable-validation-pending">pending</span>
}

@if (_cancellationObserved)
{
    <span id="cancelable-validator-cancellation-observed">observed</span>
}

@if (_exceptionType is not null)
{
    <span id="cancelable-validation-exception">@_exceptionType</span>
}

<span id="cancelable-validation-faulted">@_editContext.IsValidationFaulted()</span>

@code {
    private readonly EditContext _editContext = new(new Model());
    private CancellationTokenSource _validationCancellationSource;
    private bool _validatorStarted;
    private bool _cancellationObserved;
    private string _exceptionType;

    protected override void OnInitialized()
    {
        _editContext.OnValidationRequested += HandleValidationRequested;
        _editContext.OnValidationStateChanged += HandleValidationStateChanged;
    }

    private void HandleValidationRequested(object sender, ValidationRequestedEventArgs eventArgs)
        => eventArgs.AddAsyncValidator(WaitForCancellationAsync);

    private async Task WaitForCancellationAsync(CancellationToken cancellationToken)
    {
        _validatorStarted = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(Timeout.Infinite, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _cancellationObserved = true;
            await InvokeAsync(StateHasChanged);
            throw;
        }
    }

    private async Task StartValidationAsync()
    {
        _validationCancellationSource?.Dispose();
        _validationCancellationSource = new CancellationTokenSource();
        _validatorStarted = false;
        _cancellationObserved = false;
        _exceptionType = null;

        try
        {
            await _editContext.ValidateAsync(_validationCancellationSource.Token);
        }
        catch (OperationCanceledException)
        {
            _exceptionType = nameof(OperationCanceledException);
        }
    }

    private void CancelValidation() => _validationCancellationSource.Cancel();

    private void HandleValidationStateChanged(object sender, ValidationStateChangedEventArgs eventArgs)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _validationCancellationSource?.Cancel();
        _validationCancellationSource?.Dispose();
        _editContext.OnValidationRequested -= HandleValidationRequested;
        _editContext.OnValidationStateChanged -= HandleValidationStateChanged;
    }

    private sealed class Model;
}